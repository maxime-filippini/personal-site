{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "upload_source_maps": true
}
