{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "22.22.1",
    "pnpm": "11.23.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm run build && playwright test",
    "content:inventory": "tsx scripts/content-inventory.ts",
    "content:inventory:write": "tsx scripts/content-inventory.ts --write",
    "content:check": "tsx scripts/content-inventory.ts --check",
    "check": "pnpm content:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:browser"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "1.167.38",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.0.1",
    "globals": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
